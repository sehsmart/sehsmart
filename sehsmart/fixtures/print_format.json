pper {\r\n        position: relative;\r\n        height: 100%;\r\n    }\r\n\r\n    .footer1 {\r\n        position: absolute;\r\n        bottom: -75mm;\r\n        width: 100%;\r\n        text-align: right;\r\n        font-size: 12px;\r\n        /*font-family: 'TH SarabunPSK';*/\r\n    }\r\n    .footer2 {\r\n        position: absolute;\r\n        bottom: 4mm;\r\n        width: 98%;\r\n        text-align: right;\r\n        font-size: 12px;\r\n        /*font-family: 'TH SarabunPSK';*/\r\n    }\r\n\r\n    .footer3_nodiscount {\r\n        position: absolute;\r\n        bottom: -50mm;\r\n        width: 98%;\r\n        text-align: right;\r\n        font-size: 12px;\r\n        /*font-family: 'TH SarabunPSK';*/\r\n    }\r\n\r\n\r\n    .item {\r\n        position: absolute;\r\n        Top: 90mm;\r\n        width: 100%;\r\n        text-align: left;\r\n        \r\n    }\r\n\r\n\r\n</style>\r\n\r\n\r\n\r\n{% set user = frappe.get_doc(\"User\", doc.owner) %}\r\n\r\n{% set day = frappe.utils.get_datetime(doc.posting_date).strftime('%d') %}\r\n{% set month = frappe.utils.get_datetime(doc.posting_date).strftime('%m') %}\r\n{% set y = frappe.utils.get_datetime(doc.posting_date).strftime('%Y') %}\r\n{% set thyear = y | int + 543 %}\r\n\r\n{% if month == \"01\" %}\r\n{% set thai_month = \"มกราคม\" %}\r\n{% elif month == \"02\" %}\r\n{% set thai_month = \"กุมภาพันธ์\" %}\r\n{% elif month == \"03\" %}\r\n{% set thai_month = \"มีนาคม\" %}\r\n{% elif month == \"04\" %}\r\n{% set thai_month = \"เมษายน\" %}\r\n{% elif month == \"05\" %}\r\n{% set thai_month = \"พฤษภาคม\" %}\r\n{% elif month == \"06\" %}\r\n{% set thai_month = \"มิถุนายน\" %}\r\n{% elif month == \"07\" %}\r\n{% set thai_month = \"กรกฎาคม\" %}\r\n{% elif month == \"08\" %}\r\n{% set thai_month = \"สิงหาคม\" %}\r\n{% elif month == \"09\" %}\r\n{% set thai_month = \"กันยายน\" %}\r\n{% elif month == \"10\" %}\r\n{% set thai_month = \"ตุลาคม\" %}\r\n{% elif month == \"11\" %}\r\n{% set thai_month = \"พฤศจิกายน\" %}\r\n{% elif month == \"12\" %}\r\n{% set thai_month = \"ธันวาคม\" %}\r\n{% endif %}\r\n\r\n\r\n<div style=\"height: 297mm;\" class=\"sales\">\r\n    <div class=\"content-wrapper\">\r\n    <div style=\"height: 22mm; width: 100%\"></div>\r\n      <div style=\"position:absolute; right:20px; top:20px; \">\r\n        <p style=\"color:red;\">*ระยะทดลองการใช้งาน</p>\r\n      </div>\r\n        <div>\r\n            <h1 style=\"text-align: center;\"><b>ใบขาย</b></h1>\r\n        </div>\r\n\r\n        <div>\r\n            <table style=\"margin-top: 4mm; width: 100%;\">\r\n                <tr>\r\n                    <td style=\"text-indent: 10mm\"><b>ชื่อ-นามสกุลคนไข้: </b></td>\r\n                    <td style=\"width: 98mm;\">{{ doc.fullname }}</td>\r\n                    <td style=\"width: 22mm;\"><b>เลขที่ใบขาย: </b></td>\r\n                    <td style=\"width: 48mm;\">{{ doc.name }}</td>\r\n                </tr>\r\n            </table>\r\n        </div>\r\n\r\n        <div>\r\n            <table style=\"margin-top: -1mm; width: 100%;\">\r\n                <tr>\r\n                    <td style=\"text-indent: 10mm;\"><b>HN: </b></td>\r\n                    <td style=\"width: 128mm;\">{{ doc.hn }}</td>\r\n                    <td style=\"width: 17mm;\"><b>วันที่ขาย: </b></td>\r\n                    <td style=\"width: 47mm;\">{{ day }} {{ thai_month }} {{ thyear }}</td>\r\n                </tr>\r\n            </table>\r\n        </div>\r\n\r\n        <div>\r\n            <table style=\"margin-top: -1mm; width: 100%\">\r\n                <tr>\r\n                    <td style=\"text-indent: 10mm;\"><b>เบอร์โทรติดต่อ:</b></td>\r\n                    <td style=\"width: 174mm;\">{{ doc.tel or '-'}}</td> \r\n                </tr>\r\n            </table>\r\n        </div>\r\n\r\n        <div>\r\n            <table style=\"margin-top: -1mm; width: 50%\">\r\n                <tr>\r\n                    <td style=\"text-indent: 10mm;\"><b>เวลาทำการโรงพยาบาล: </b></td>\r\n                    <td style=\"width: 55mm;\">จันทร์-ศุกร์ เวลา 8.00-20.00 น. <br>\r\n                        เสาร์-อาทิตย์ เวลา 8.00-16.00 น. <br>\r\n                        เบอร์โทร 077-276999 ต่อ 137\r\n                    </td> \r\n                </tr>\r\n            </table>\r\n        </div>\r\n\r\n            <div style=\"display: flex; justify-content: flex-start; align-items: center; width: 100%; margin-left: 10mm;\">\r\n   <table style=\"margin-top: -1mm;\">\r\n       <tr>\r\n        <td><b>แคมเปญ: </b></td>\r\n           <td style=\"display: flex; align-items: center; gap: 15px;\">\r\n               <div style=\"display: flex; align-items: center; gap: 5px;\">\r\n                  {{ doc.campain_name or '-' }}\r\n               </div>\r\n           </td>\r\n       </tr>\r\n   </table>\r\n</div>\r\n\r\n\r\n        <div class=\"item pt-2\">\r\n            <div style=\"margin-top: -20mm; height: 160mm;\">\r\n                <table style=\"margin: 38px; width: 90%\">\r\n                    <tr>\r\n                        <th class=\"bordered-heading no\" style=\"width: 7mm; text-align: center; border: 1px solid black;\"><b>No.</b></th>\r\n                        <th class=\"bordered-heading order\" style=\"width: 25mm; text-align: center; border: 1px solid black;\"><b>Code</b></th>\r\n                        <th class=\"bordered-heading order\" style=\"width: 49mm; text-align: center; border: 1px solid black;\"><b>ยี่ห้อ</b></th>\r\n                        <th class=\"bordered-heading total\" style=\"width: 48mm; text-align: center; border: 1px solid black;\"><b>รุ่น/ประเภท</b></th>\r\n                        <th class=\"bordered-heading total\" style=\"width: 13mm; text-align: center; border: 1px solid black;\"><b>จำนวน</b></th>\r\n                        <th class=\"bordered-heading unit\" style=\"width: 18mm; text-align: center; border: 1px solid black;\"><b>ราคา/หน่วย</b></th>\r\n                    </tr>\r\n                    \r\n                    {% for ett in doc.eyewear_transaction_table %}\r\n                        {% set bar = frappe.get_doc(\"Eyeglasses Information\", ett.barcode) %}\r\n                    \r\n                    <tr>\r\n                        <td style=\"text-align: center; border: 1px solid black;\">{{ ett.idx }}</td>\r\n                        <td style=\"text-align: left; border: 1px solid black;\">{{ ett.barcode or ''}}</td>\r\n                        <td style=\"text-align: left; border: 1px solid black;\">{{ ett.brand or ''}}</td>\r\n\r\n                        {% if ett.type == \"เลนส์\"%}\r\n                            <td style=\"text-align: left; border: 1px solid black;\">{{ bar.lens_types or '' }}</td>\r\n                        {% else %}\r\n                            <td style=\"text-align: left; border: 1px solid black;\">{{ ett.model or '' }}</td>\r\n                        {% endif %}\r\n                        \r\n                        <td style=\"text-align: center; border: 1px solid black;\">{{ ett.qty }}</td>\r\n                        \r\n                        {% if ett.type == \"เลนส์\" and ett.model == \"000เลนส์สั่งตัด\" %}\r\n                            <td style=\"text-align: center; border: 1px solid black;\">{{ '{:20,.2f}'.format(ett.actual_selling_price) }}</td> \r\n                        {% else %}\r\n                            <td style=\"text-align: center; border: 1px solid black;\">{{ '{:20,.2f}'.format(ett.selling_price) }}</td> \r\n                        {% endif %}\r\n                    </tr>\r\n\r\n                    {% endfor %}\r\n                    \r\n                </table>\r\n\r\n                <div>\r\n                    <table style=\"width: 95%;margin-top: -6mm;text-align: right;\">\r\n                        <tr>\r\n                            <td style=\"text-indent: 137mm\"><b>รวมเป็นเงิน</b></td>\r\n                            <td style=\"width: 40mm;text-align: right;\">{{ '{:20,.2f}'.format(doc.total) }}</td>\r\n                        </tr>\r\n                    </table>\r\n                </div>\r\n\r\n                <div>\r\n                    <table style=\"width: 95%; margin-top: -2mm;text-align: right;\">\r\n                        <tr>\r\n                            <td style=\"text-indent: 128mm\"><b>ส่วนลด</b></td>\r\n                            <td style=\"width: 40mm;text-align: right;\">{{ '{:20,.2f}'.format(doc.discount) }}</td>\r\n                        </tr>\r\n                    </table>\r\n                </div>\r\n\r\n                <div>\r\n                    <table style=\"width: 95%; margin-top: -2mm;text-align: right;\">\r\n                        <tr>\r\n                            <td style=\"text-indent: 128mm\"><b>รวมเงินทั้งสิ้น</b></td>\r\n                            <td style=\"width: 40mm;text-align: right;\">{{ '{:20,.2f}'.format(doc.total_amount) }}</td>\r\n                        </tr>\r\n                    </table>\r\n                </div>\r\n\r\n                {% if doc.deposit == 1 %}\r\n                <div>\r\n                    <table style=\"width: 95%; margin-top: 1mm;text-align: right;\">\r\n                        <tr>\r\n                            <td style=\"text-indent: 128mm\"><b>ยอดเงินมัดจำ</b></td>\r\n                            <td style=\"width: 40mm;text-align: right;\">{{ '{:20,.2f}'.format(doc.deposit_amount) }}</td>\r\n                        </tr>\r\n                    </table>\r\n                </div>\r\n\r\n                <div>\r\n                    <table style=\"width: 95%; margin-top: -2mm;text-align: right;\">\r\n                        <tr>\r\n                            <td style=\"text-indent: 128mm; color: red;\"><b>ยอดคงค้าง</b></td>\r\n                            <td style=\"width: 40mm;text-align: right; color: red;\">{{ '{:20,.2f}'.format(doc.outstanding_balance) }}</td>\r\n                        </tr>\r\n                    </table>\r\n                </div>\r\n\r\n                {% endif %}\r\n\r\n\r\n                <footer class=\"footer3_nodiscount\">  \r\n                    <div style=\"margin-top: 10mm; width: 100%\">\r\n                        <table style=\"width: 100%; height: 100%;\">\r\n                            <tr>\r\n                                <td style=\"width: 100%; text-align: center; vertical-align: middle; padding-left: 38mm;\">\r\n                                    <b>ลงชื่อ____________________________________</b>\r\n                                    \r\n                                </td>\r\n                            </tr>\r\n                        </table>\r\n                    </div>\r\n            \r\n                    <div style=\"margin-top: 0mm; width: 100%\">\r\n                        <table style=\"width: 100%; height: 100%;\">\r\n                            <tr>\r\n                                <td style=\"width: 100%; text-align: center; vertical-align: middle; padding-left: 38mm;\">\r\n                                    <b>( {{ user.first_name }} )</b>\r\n                                </td>\r\n                            </tr>\r\n                        </table>\r\n                    </div>\r\n            \r\n                    <div style=\"margin-top: 0mm; width: 100%\">\r\n                        <table style=\"width: 100%; height: 100%;\">\r\n                            <tr>\r\n                                <td style=\"width: 50%; text-align: center; vertical-align: middle; padding-left: 38mm;\">\r\n                                    <b>เจ้าหน้าที่ขาย</b>\r\n                                </td>\r\n                            </tr>\r\n                        </table>\r\n                    </div>\r\n\r\n                </footer>\r\n            </div>     \r\n        </div>\r\n    </div>     \r\n</div>\r\n\r\n       \r\n",
