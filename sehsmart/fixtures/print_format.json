[
 {
  "absolute_value": 0,
  "align_labels_right": 0,
  "css": null,
  "custom_format": 1,
  "default_print_language": "th",
  "disabled": 0,
  "doc_type": "polysomnogram",
  "docstatus": 0,
  "doctype": "Print Format",
  "font": null,
  "font_size": 14,
  "format_data": null,
  "html": "<style>\r\n    @import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@100;200;300;400;500;600;700;800&display=swap');\r\n       \r\n       * {\r\n           font-family: 'Sarabun', sans-serif;\r\n           box-sizing: border-box;\r\n       }\r\n       \r\n       \r\n       @media screen {\r\n           .print-format td, .print-format th {\r\n               vertical-align: top !important;\r\n               padding: 4px !important;\r\n           }\r\n           .print-format, .print-preview {\r\n               max-width: 210mm;\r\n               padding: 0mm;\r\n               min-height: 297mm;\r\n           }\r\n       }\r\n       \r\n       @page {\r\n           size: A4 portrait;\r\n           margin: 0;\r\n           \r\n       }\r\n       h5, p{\r\n           font-size: 14px;\r\n           padding-left: 10mm;\r\n       }\r\n       .un {\r\n           border-bottom: 1px solid black;\r\n           padding-bottom: 2px; \r\n           display: inline-block;\r\n       }\r\n       .title-data {\r\n           display: flex; \r\n           justify-content: space-between; \r\n           width: 100%; \r\n           font-size: 14px; \r\n           padding-left: 10mm; \r\n           padding-right: 10mm;\r\n       }\r\n      table {\r\n               width: 100%;\r\n               border-collapse: collapse;\r\n               padding-left: 10mm; \r\n               padding-right: 10mm;\r\n           }\r\n           th, td {\r\n               border: 1px solid black;\r\n               padding: 8px;\r\n               text-align: center;\r\n           }\r\n           th {\r\n               background-color: #f2f2f2;\r\n           }\r\n           td.bt{\r\n               text-align: left;\r\n           }\r\n       \r\n   </style>\r\n\r\n{% set months = {\r\n    \"01\": \"มกราคม\", \"02\": \"กุมภาพันธ์\", \"03\": \"มีนาคม\", \"04\": \"เมษายน\",\r\n    \"05\": \"พฤษภาคม\", \"06\": \"มิถุนายน\", \"07\": \"กรกฎาคม\", \"08\": \"สิงหาคม\",\r\n    \"09\": \"กันยายน\", \"10\": \"ตุลาคม\", \"11\": \"พฤศจิกายน\", \"12\": \"ธันวาคม\"\r\n} %}\r\n\r\n{% set day = frappe.utils.get_datetime(doc.posting_date).strftime('%d') %}\r\n{% set month = frappe.utils.get_datetime(doc.posting_date).strftime('%m') %}\r\n{% set thyear = frappe.utils.get_datetime(doc.posting_date).year + 543 %}\r\n{% set thai_month = months.get(month, '') %}\r\n\r\n{% set dayb = frappe.utils.get_datetime(doc.birthday).strftime('%d') %}\r\n{% set monthb = frappe.utils.get_datetime(doc.birthday).strftime('%m') %}\r\n{% set thyearb = frappe.utils.get_datetime(doc.birthday).year + 543 %}\r\n{% set thai_monthb = months.get(monthb, '') %}\r\n\r\n\r\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css\">\r\n\r\n<div class=\"pt-4\">\r\n    <img src=\"/files/Headlogo.png\">\r\n    <h4 style=\"text-align: center;\"><b>แบบทดสอบระดับความง่วงนอน</b></h4>\r\n    <h4 style=\"text-align: center;\"><b>(The Epworth Sleepiness Scale : ESS)</b></h4>\r\n</div>\r\n\r\n<div>\r\n    <h5>ข้อมูลทั่วไป</h5>\r\n\r\n    <div class=\"title-data pt-2\">\r\n    <span>ชื่อ-สกุล: <ins>{{ doc.fullname }}</ins></span>\r\n    <span>อายุ: <ins>{{ doc.age }}</ins> ปี</span>\r\n    <span>เพศ: <ins>{{ doc.gender }}</ins></span>\r\n    <span>วัน/เดือน/ปีเกิด: \r\n    {% if doc.birthday %}\r\n    <ins>\r\n        {{dayb or ''}} {{thai_monthb or ''}} {{thyearb or ''}}\r\n    </ins>\r\n    {% endif %}\r\n    </span>\r\n    </div>\r\n    \r\n    <div class=\"title-data pt-2\">\r\n    <span>ชื่อ-สกุล ภาษาอังกฤษ: <ins>{{ doc.fullname_eng or '' }}</ins> HN: <ins>{{ doc.hn or '' }}</ins> ที่อยู่: บ้านเลขที่ <ins>{{ doc.no or '' }}</ins> หมู่ที่ <ins>{{ doc.moo or '-' }}</ins> ถนน <ins>{{ doc.road or '-' }}</ins> ซอย <ins>{{ doc.soi or '-' }}</ins> </span>\r\n    </div>\r\n\r\n    <div class=\"title-data pt-2\">\r\n    <span>ตำบล <ins>{{ doc.tambon or '' }}</ins> อำเภอ <ins>{{ doc.amphoe or '' }}</ins> จังหวัด <ins>{{ doc.province or '' }}</ins> รหัสไปรษณีย์ <ins>{{ doc.postal_code or '' }}</ins> เบอร์โทรศัพท์: <ins>{{ doc.phone or '' }}</ins> </span>\r\n    </div>\r\n\r\n    <div class=\"title-data pt-2\">\r\n        <span>น้ำหนัก: <ins>{{ doc.weight or '' }}</ins> kg. ส่วนสูง: <ins>{{ doc.height or '' }}</ins> cm. BMI: <ins>{{ doc.bmi }}</ins> รอบคอ: <ins>{{ doc.neck_circumference or '' }}</ins> cm. </span>\r\n    </div>\r\n\r\n    <div class=\"title-data pt-2\">\r\n    <span>กรณีฉุกเฉินติดต่อ: <ins>{{ doc.fullname_r or '' }}</ins> เบอร์โทรศัพท์: <ins>{{ doc.phone_r or '' }}</ins> </span>\r\n    </div>\r\n\r\n  \r\n\r\n    <div class=\"title-data pt-2 pt-2\">\r\n    <span>กรุณาทำเครื่องหมาย ✓ ลงในช่องคำตอบที่ตรงกับข้อมูลของท่าน </span>\r\n    </div>\r\n        \r\n</div>\r\n\r\n<div class=\"title-data pt-2\">\r\n    <span>1. ท่านมีโรคประจำตัวหรือไม่?\r\n        \r\n        <i class=\"fa fa-{% if doc.get('null') %}check-{% endif %}square-o\"></i> ไม่มี\r\n        <i class=\"fa fa-{% if doc.get('have') %}check-{% endif %}square-o\"></i> มี\r\n        {% if doc.get('have') and doc.get('specify') %} ระบุ: <ins>{{ doc.get('specify') }}</ins> {% endif %}\r\n    </span>\r\n</div>\r\n\r\n<div class=\"title-data pt-2\">\r\n    <span>2.1. ท่านดื่มกาแฟ เป็นประจำหรือไม่?\r\n        <i class=\"fa fa-{% if doc.get('nocoffee') %}check-{% endif %}square-o\"></i> ไม่ดื่ม\r\n        <i class=\"fa fa-{% if doc.get('coffee') %}check-{% endif %}square-o\"></i> ดื่ม\r\n        {% if doc.get('coffee') and doc.get('daily_qty') %} จำนวนต่อวัน <ins>{{ doc.get('daily_qty') or '' }}</ins> {% endif %}\r\n    </span>\r\n</div>\r\n\r\n<div class=\"title-data pt-2\">\r\n    <span>2.2. ท่านดื่มเครื่องดื่มที่มีแอลกอฮอล์ เป็นประจำหรือไม่?\r\n        <i class=\"fa fa-{% if doc.get('nodrink') %}check-{% endif %}square-o\"></i> ไม่ดื่ม\r\n        <i class=\"fa fa-{% if doc.get('drink') %}check-{% endif %}square-o\"></i> ดื่ม\r\n        {% if doc.get('drink') and doc.get('daily_qty2') %} จำนวนโดยประมาณ <ins>{{ doc.get('daily_qty2') or '' }}</ins> {% endif %}\r\n    </span>\r\n</div>\r\n\r\n<div class=\"title-data pt-2\">\r\n    <span>2.3. ท่านสูบบุหรี่ เป็นประจำหรือไม่?\r\n        <i class=\"fa fa-{% if doc.get('nocigarette') %}check-{% endif %}square-o\"></i> ไม่สูบ\r\n        <i class=\"fa fa-{% if doc.get('cigarette') %}check-{% endif %}square-o\"></i> สูบ\r\n        {% if doc.get('cigarette') and doc.get('daily_qty3') %} จำนวนต่อวัน <ins>{{ doc.get('daily_qty3') or '' }}</ins> {% endif %}\r\n    </span>\r\n</div>\r\n\r\n<div class=\"title-data pt-2\">\r\n    <span>3. ท่านนอนกรนหรือไม่?\r\n        <i class=\"fa fa-{% if doc.get('nosnore') %}check-{% endif %}square-o\"></i> ไม่กรน\r\n        <i class=\"fa fa-{% if doc.get('snore') %}check-{% endif %}square-o\"></i> กรน\r\n        {% if doc.get('snore') %} ดังระดับ: <ins>{{ doc.get('level') }}</ins> {% endif %}\r\n    </span>\r\n</div>\r\n\r\n<div class=\"title-data pt-2\">\r\n    <span>4. ท่านเคยได้รับการตรวจการนอนหลับมาก่อนหรือไม่?\r\n        <i class=\"fa fa-{% if doc.get('non') %}check-{% endif %}square-o\"></i> ไม่เคย\r\n        <i class=\"fa fa-{% if doc.get('sleeptest') %}check-{% endif %}square-o\"></i> เคย\r\n        {% if doc.get('sleeptest') and doc.get('note') %} ระบุ: รพ.<ins>{{ doc.get('note') or ''}}</ins> {% endif %}\r\n    </span>\r\n</div>\r\n\r\n<div class=\"title-data pt-2\">\r\n    <span>5. ท่านเคยใช้เครื่องอัดอากาศแรงดันบวก (CPAP) มาก่อนหรือไม่?\r\n        <i class=\"fa fa-{% if doc.get('nocpap') %}check-{% endif %}square-o\"></i> ไม่เคย\r\n        <i class=\"fa fa-{% if doc.get('cpap') %}check-{% endif %}square-o\"></i> เคย\r\n        {% if doc.get('cpap') and doc.get('brand') %} ระบุ: ยี่ห้อ<ins>{{ doc.get('brand') or '' }}</ins> ประเภทการใช้งาน: <ins>{{ doc.type_use}}</ins> {% endif %}\r\n    </span>\r\n</div>\r\n\r\n<div class=\"title-data pt-2\">\r\n    <span>ในสถานการณ์ดังต่อไปนี้ ท่านมีอาการง่วงหรือมีความเป็นไปได้ที่จะงีบหรือเผลอหลับ มากน้อยเพียงใด</span>\r\n</div>\r\n\r\n{% set questions = [\r\n    \"1. ขณะนั่งอ่านหนังสือ / สื่อสิ่งพิมพ์ต่าง ๆ\",\r\n    \"2. ขณะนั่งดูโทรทัศน์\",\r\n    \"3. ขณะนั่งนิ่ง ๆ ในที่สาธารณะ, ที่ประชุมหรือโรงภาพยนตร์\",\r\n    \"4. ขณะโดยสารในรถ, เรือหรือเครื่องบินเป็นเวลามากกว่า 1 ชั่วโมง\",\r\n    \"5. ขณะนอนพักผ่อนตอนกลางวันเมื่อมีโอกาส\",\r\n    \"6. ขณะนั่งพูดคุยกับผู้อื่น\",\r\n    \"7. ขณะนั่งพักหลังรับประทานอาหารกลางวัน\",\r\n    \"8. ขณะขับขี่ยานพาหนะที่มีการจราจรติดขัด / ติดไฟแดงนาน 3-5 นาที\"\r\n] %}\r\n\r\n{% set options = [\"0<br>ไม่งีบ/เผลอหลับ\", \"1<br>เล็กน้อย\", \"2<br>ปานกลาง\", \"3<br>เป็นประจำ\"] %}\r\n\r\n<div class=\"title-data pt-2\">\r\n    <table border=\"1\" style=\"border-collapse: collapse; width: 100%;\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"padding: 8px; text-align: center; width: 50%;\">สถานการณ์</th>\r\n                {% for option in options %}\r\n                    <th style=\"padding: 8px; text-align: center;\">{{ option }}</th>\r\n                {% endfor %}\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for i in range(8) %}\r\n                <tr>\r\n                    <td style=\"padding: 8px; text-align: left;\">{{ questions[i] }}</td>\r\n                    \r\n                    {% for j in range(4) %}\r\n                        <td style=\"padding: 8px; text-align: center;\">\r\n                            {# ดึงค่า select_key จาก index i ซึ่งเป็นช่องใน Doctype #}\r\n                            {% set selected_value = doc['select_key' ~ i] %}\r\n                            \r\n                            {# เปรียบเทียบค่าของ select_key กับ options เพื่อแสดงเครื่องหมายติ๊ก #}\r\n                            {% if selected_value == options[j] %}\r\n                                <i class=\"fa fa-check-square-o\"></i>\r\n                            {% else %}\r\n                                <i class=\"fa fa-square-o\"></i>\r\n                            {% endif %}\r\n                        </td>\r\n                    {% endfor %}\r\n                </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n</div>\r\n\r\n\r\n<div class=\"title-data pt-3\">\r\n    <span><b>คะแนนรวม {{ doc.total }} ผลการประเมิน:</b> {{ doc.evaluation }}</span>\r\n</div>\r\n\r\n\r\n<div class=\"page-break\"></div>\r\n\r\n <style>\r\n@import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@100;200;300;400;500;600;700;800&display=swap');\r\n\r\n* {\r\n    font-family: 'Sarabun', sans-serif;\r\n    box-sizing: border-box;\r\n}\r\n\r\n@media screen {\r\n    .print-format td, .print-format th {\r\n        vertical-align: top !important;\r\n        padding: 4px !important;\r\n    }\r\n    .print-format, .print-preview {\r\n        max-width: 210mm;\r\n        padding: 0mm;\r\n        min-height: 297mm;\r\n    }\r\n}\r\n\r\n@page {\r\n    size: A4 portrait;\r\n    margin: 0;\r\n}\r\n\r\nh5, p {\r\n    font-size: 14px;\r\n    padding-left: 10mm;\r\n}\r\n\r\n.un {\r\n    border-bottom: 1px solid black;\r\n    padding-bottom: 2px; \r\n    display: inline-block;\r\n}\r\n\r\n.title-data1 {\r\n    display: flex; \r\n    justify-content: space-between; \r\n    width: 100%; \r\n    font-size: 14px; \r\n    padding-left: 10mm; \r\n    padding-right: 10mm;\r\n}\r\n\r\n.table1 {\r\n    width: 100%;\r\n    table-layout: fixed;\r\n    border-collapse: collapse;\r\n    padding-left: 10mm; \r\n    padding-right: 10mm;\r\n}\r\n\r\n.table1 th, .table1 td {\r\n    border-top: none;\r\n    border-left: none;\r\n    border-right: none; \r\n    border-bottom: none; \r\n    padding: 8px;\r\n    text-align: center;\r\n    word-wrap: break-word;\r\n    overflow-wrap: break-word;\r\n    white-space: normal;\r\n    max-width: 90%;\r\n}\r\n\r\n.table1 td {\r\n    text-align: left;\r\n}\r\n\r\n.table1 th {\r\n    background-color: #f2f2f2;\r\n}\r\n\r\n\r\nth {\r\n    background-color: #f2f2f2;\r\n}\r\n\r\ntd.bt {\r\n    text-align: left;\r\n}\r\n\r\n.row {\r\n    padding-left: 10mm; \r\n    padding-right: 10mm;\r\n}\r\n\r\n.title-data1.flex-end {\r\n    display: flex;\r\n    justify-content: flex-end;\r\n}\r\n</style>\r\n\r\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css\">\r\n\r\n<div class=\"pt-4\">\r\n    <img src=\"/files/Headlogo.png\">\r\n    <h4 style=\"text-align: center;\"><b>แบบซักประวัติ ประเมินโรคจากการนอนหลับ</b></h4>\r\n</div>\r\n\r\n<div>\r\n    <div class=\"title-data1\">\r\n        <span>ชื่อ: <ins>{{ doc.fullname }}</ins></span>\r\n        <span>อายุ: <ins>{{ doc.age }}</ins> ปี</span>\r\n        <span>BMI: <ins>{{ doc.bmi }}</ins></span>\r\n    </div>\r\n\r\n    <div class=\"title-data1 pt-2\">\r\n        <span><i class=\"fa fa-{% if doc.get('chk_eye') %}check-{% endif %}square-o\"></i> Consult จาก OPD EYE  \r\n            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; \r\n            <i class=\"fa fa-{% if doc.get('chk_ent') %}check-{% endif %}square-o\"></i> Consult จาก OPD ENT \r\n        </span>\r\n    </div>\r\n\r\n    <div class=\"title-data1 pt-2\">\r\n        <span>โรคประจำตัว: <ins>{{ doc.specify or ''}}</ins> </span>\r\n        <span>สิทธิการรักษา: <ins>{{ doc.type_treatment or '' }}</ins> </span>\r\n        <span>เวลาเข้านอน: <ins>{{ doc.get_formatted (\"time_gobed\") or '-' }} </ins> น. </span> \r\n        <span>เวลาตื่นนอน: <ins>{{ doc.get_formatted (\"time_getup\") or '-' }}</ins> น. </span>\r\n    </div>\r\n\r\n    <div class=\"title-data1 pt-2\">\r\n        <span>ประวัติการใช้ยากลุ่มจิตเวช หรือยานอนหลับ:  \r\n            <i class=\"fa fa-{% if doc.get('no_drug') %}check-{% endif %}square-o\"></i> ไม่มี\r\n            <i class=\"fa fa-{% if doc.get('drug') %}check-{% endif %}square-o\"></i> มี\r\n            {% if doc.get('drug') and doc.get('data_wxjr') %} ระบุ: <ins>{{ doc.get('data_wxjr') or '' }}</ins> {% endif %}\r\n        </span>\r\n    </div>\r\n\r\n    <div class=\"title-data1 pt-2\">\r\n        <span>ปัญหาหลัก:  </span>\r\n    </div>\r\n\r\n    <div class=\"title-data1 pt-2\">\r\n        <span>\r\n            <i class=\"fa fa-{% if doc.get('main') %}check-{% endif %}square-o\"></i> กรน\r\n            <i class=\"fa fa-{% if doc.get('main1') %}check-{% endif %}square-o\"></i> หลับไม่สนิทในระหว่างคืน \r\n            <i class=\"fa fa-{% if doc.get('main2') %}check-{% endif %}square-o\"></i> ละเมอ\r\n            <i class=\"fa fa-{% if doc.get('main3') %}check-{% endif %}square-o\"></i> ง่วงนอนระหว่างวัน\r\n            <i class=\"fa fa-{% if doc.get('main4') %}check-{% endif %}square-o\"></i> ขากระตุก หรือตะคริวระหว่างคืน\r\n            <i class=\"fa fa-{% if doc.get('main5') %}check-{% endif %}square-o\"></i> นอนกัดฟัน\r\n        </span>\r\n    </div>\r\n\r\n    <div class=\"title-data1 pt-2\">\r\n        <span>\r\n            <i class=\"fa fa-{% if doc.get('main6') %}check-{% endif %}square-o\"></i> ปวดศีรษะในตอนเช้า\r\n            <i class=\"fa fa-{% if doc.get('main7') %}check-{% endif %}square-o\"></i> นอนไม่หลับ\r\n            <i class=\"fa fa-{% if doc.get('main8') %}check-{% endif %}square-o\"></i> อื่น ๆ \r\n            {% if doc.get('main8') and doc.get('textmain8') %} ระบุ: <ins>{{ doc.get('textmain8') or '' }}</ins> {% endif %}\r\n        </span>\r\n    </div>\r\n\r\n    <div class=\"title-data1 pt-2\">\r\n        <table class=\"table1\">\r\n            <tr>\r\n                <td width=\"25%\" class=\"bt\">Physical examination:</td>\r\n                <td width=\"80%\" class=\"bt\">{{ doc.get('text_editor') or '' }}</td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <div class=\"title-data1 pt-2\">\r\n        <table class=\"table1\">\r\n            <tr>\r\n                <td width=\"20%\" class=\"bt\">Nose:</td>\r\n                <td width=\"80%\" class=\"bt\"> {{ doc.get('text_editor1') or '' }} </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <div class=\"title-data1 pt-2\">\r\n        <table class=\"table1\">\r\n            <tr>\r\n                <td width=\"20%\" class=\"bt\">Throat:</td>\r\n                <td width=\"80%\" class=\"bt\"> {{ doc.get('text_editor2') or '' }} </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <div class=\"title-data1 pt-2\">\r\n        <div class=\"row\"> <i class=\"fa fa-{% if doc.get('chk_imga') %}check-{% endif %}square-o\"></i> A <img src=\"/files/2ef14eb.png\"></div>\r\n        <div class=\"row\"> <i class=\"fa fa-{% if doc.get('chk_imgb') %}check-{% endif %}square-o\"></i> B <img src=\"/files/3.png\"></div>\r\n        <div class=\"row\"> <i class=\"fa fa-{% if doc.get('chk_imgc') %}check-{% endif %}square-o\"></i> C <img src=\"/files/4.png\"></div>\r\n        <div class=\"row\"> <i class=\"fa fa-{% if doc.get('chk_imgd') %}check-{% endif %}square-o\"></i> D <img src=\"/files/5.png\"></div>\r\n        <div class=\"row\"> <i class=\"fa fa-{% if doc.get('chk_imge') %}check-{% endif %}square-o\"></i> E <img src=\"/files/6.png\"></div>\r\n    </div>\r\n\r\n    <div class=\"title-data1 pt-3\">\r\n        <span>Impression:  \r\n            <i class=\"fa fa-{% if doc.get('ro_osa') %}check-{% endif %}square-o\"></i> R/O OSA &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\r\n            <i class=\"fa fa-{% if doc.get('other_sleep_disorder') %}check-{% endif %}square-o\"></i> Other Sleep Disorders\r\n        </span>\r\n    </div>\r\n\r\n    <div class=\"title-data1 pt-2\">\r\n        <span>\r\n            <i class=\"fa fa-{% if doc.get('psg_type_1') %}check-{% endif %}square-o\"></i> PSG Type 1 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\r\n            <i class=\"fa fa-{% if doc.get('psg_type_3') %}check-{% endif %}square-o\"></i> PSG Type 3\r\n        </span>\r\n    </div>\r\n\r\n    <div class=\"title-data1 pt-2\">\r\n        <table class=\"table1\">\r\n            <tr>\r\n                <td width=\"80%\" class=\"bt\">Special note สำหรับวันเข้ารับการตรวจ Sleep Test:</td>\r\n                <td width=\"100%\" class=\"bt\">{{ doc.get('note_special') or ''}} </td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <div class=\"title-data1 pt-5 flex-end\">\r\n        <span>ผู้บันทึก: <ins>{{ doc.get('fullname_emp') }}</ins> </span>\r\n    </div>\r\n</div>\r\n",
