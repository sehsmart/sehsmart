  "html": "<style>\r\n    @import url('https://fonts.googleapis.com/css2?family=Sarabun:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800&display=swap');\r\n   @media screen {\r\n       .print-format td, .print-format th {\r\n           vertical-align: top !important;\r\n           padding: 4px !important;\r\n       }\r\n       .print-format {\r\n           max-width: 210mm;\r\n           padding: 0mm;\r\n           min-height: 148mm;\r\n       }\r\n       .print-preview {\r\n           max-width: 210mm;\r\n           padding: 0mm;\r\n           min-height: 148mm;\r\n       }\r\n   }\r\n   \r\n   @page {\r\n       size: 210mm 148mm landscape;\r\n       margin: 0;\r\n   }\r\n\r\n    *{\r\n         font-family: 'Sarabun';\r\n         box-sizing: border-box;\r\n   }    \r\n\r\n   .sales {\r\n       background-image: url(/files/Logo_landscape_glass.png);\r\n       background-size: cover;\r\n       background-repeat: no-repeat;\r\n       background-position: center center;\r\n       width: 100%;\r\n   }\r\n   \r\n   .print-format td, .print-format th {\r\n       vertical-align: top !important;\r\n       padding: 4px !important;\r\n   }\r\n   \r\n   td {\r\n       font-size: 14px;\r\n   }\r\n   \r\n   .bordered-heading {\r\n       border-top: 1px solid black;\r\n       border-bottom: 1px solid black;\r\n   }\r\n\r\n   h1{\r\n       font-size: 18px;\r\n   }\r\n\r\n\r\n</style>\r\n\r\n{% set day = frappe.utils.get_datetime(doc.posting_date).strftime('%d') %}\r\n{% set month = frappe.utils.get_datetime(doc.posting_date).strftime('%m') %}\r\n{% set y = frappe.utils.get_datetime(doc.posting_date).strftime('%Y') %}\r\n{% set thyear = y | int + 543 %}\r\n\r\n{% if month == \"01\" %}\r\n{% set thai_month = \"มกราคม\" %}\r\n{% elif month == \"02\" %}\r\n{% set thai_month = \"กุมภาพันธ์\" %}\r\n{% elif month == \"03\" %}\r\n{% set thai_month = \"มีนาคม\" %}\r\n{% elif month == \"04\" %}\r\n{% set thai_month = \"เมษายน\" %}\r\n{% elif month == \"05\" %}\r\n{% set thai_month = \"พฤษภาคม\" %}\r\n{% elif month == \"06\" %}\r\n{% set thai_month = \"มิถุนายน\" %}\r\n{% elif month == \"07\" %}\r\n{% set thai_month = \"กรกฎาคม\" %}\r\n{% elif month == \"08\" %}\r\n{% set thai_month = \"สิงหาคม\" %}\r\n{% elif month == \"09\" %}\r\n{% set thai_month = \"กันยายน\" %}\r\n{% elif month == \"10\" %}\r\n{% set thai_month = \"ตุลาคม\" %}\r\n{% elif month == \"11\" %}\r\n{% set thai_month = \"พฤศจิกายน\" %}\r\n{% elif month == \"12\" %}\r\n{% set thai_month = \"ธันวาคม\" %}\r\n{% endif %}\r\n\r\n\r\n<div style=\"height: 148mm;\" class = \"sales\">\r\n   <div style=\"height: 2mm; width: 100%\"></div>\r\n   \r\n   <div style=\"margin-top: 2mm; margin-right: 5mm; text-align: end;\">\r\n       <p style=\"color:red; font-size:14px; font-weight:bold;\">*ระยะทดลองการใช้งาน</p>\r\n   </div>\r\n\r\n\r\n   <div style=\"margin-top: 2mm; text-align: center;\">\r\n       <h1 style=\"text-align: center;\"><b>ใบรับแว่น/เลนส์</b></h1>\r\n   </div>\r\n   \r\n\r\n   <div>\r\n       <table style=\"margin-top: 5mm; width: 100%\">\r\n           <tr>\r\n               <td style=\"text-indent: 8mm\"><b>ชื่อ-นามสกุล: </b></td>\r\n               <td style=\"width: 110mm;\">{{ doc.fullname }}</td>\r\n               <td style=\"width: 22mm;\"><b>เลขที่ใบขาย: </b></td>\r\n               <td style=\"width: 40mm;\">{{ doc.name }}</td>\r\n           </tr>\r\n       </table>\r\n   </div>\r\n\r\n   <div>\r\n       <table style=\"margin-top: -1mm; width: 100%;\">\r\n           <tr>\r\n               <td style=\"text-indent: 8mm;\"><b>HN: </b></td>\r\n               <td style=\"width: 122mm;\">{{ doc.hn }}</td>\r\n               <td style=\"width: 26mm;\"><b>วันที่มาตัดแว่น: </b></td>\r\n               <td style=\"width: 40mm;\">{{ day }} {{ thai_month }} {{ thyear }}</td>\r\n           </tr>\r\n       </table>\r\n   </div>\r\n\r\n   <div style=\"display: flex; justify-content: flex-start; align-items: center; width: 100%; margin-left: 8mm;\">\r\n   <table style=\"margin-top: -1mm;\">\r\n       <tr>\r\n           <td style=\"display: flex; align-items: center; gap: 15px;\">\r\n               <div style=\"display: flex; align-items: center; gap: 5px;\">\r\n                   <span style=\"display: flex; justify-content: center; align-items: center; width: 20px; height: 20px; border: 1px solid black; font-size: 16px;\">\r\n                       {% if doc.have_glasses %}✓{% endif %}\r\n                   </span> มีแว่น\r\n               </div>\r\n\r\n               <div style=\"display: flex; align-items: center; gap: 5px;\">\r\n                   <span style=\"display: flex; justify-content: center; align-items: center; width: 20px; height: 20px; border: 1px solid black; font-size: 16px;\">\r\n                       {% if doc.no_glasses %}✓{% endif %}\r\n                   </span> ไม่มีแว่น\r\n               </div>\r\n           </td>\r\n       </tr>\r\n   </table>\r\n</div>\r\n\r\n   <div style=\"display: flex; justify-content: flex-start; align-items: center; width: 100%; margin-left: 8mm;\">\r\n   <table style=\"margin-top: -1mm;\">\r\n       <tr>\r\n        <td><b>แคมเปญ: </b></td>\r\n           <td style=\"display: flex; align-items: center; gap: 15px;\">\r\n               <div style=\"display: flex; align-items: center; gap: 5px;\">\r\n                  {{ doc.campain_name or '-' }}\r\n               </div>\r\n           </td>\r\n       </tr>\r\n   </table>\r\n</div>\r\n\r\n\r\n   \r\n           \r\n   <div style=\"margin-top: 1mm; height: 80mm;\">\r\n    <table style=\"margin: 38px; width: 90%\">\r\n        <tr>\r\n            <th class=\"bordered-heading no\" style=\"width: 7mm; text-align: center; border: 1px solid black;\"><b>No.</b></th>\r\n            <th class=\"bordered-heading order\" style=\"width: 25mm; text-align: center; border: 1px solid black;\"><b>Code</b></th>\r\n            <th class=\"bordered-heading order\" style=\"width: 49mm; text-align: center; border: 1px solid black;\"><b>ยี่ห้อ</b></th>\r\n            <th class=\"bordered-heading total\" style=\"width: 48mm; text-align: center; border: 1px solid black;\"><b>รุ่น/ประเภท</b></th>\r\n            <th class=\"bordered-heading total\" style=\"width: 13mm; text-align: center; border: 1px solid black;\"><b>จำนวน</b></th>\r\n            <th class=\"bordered-heading unit\" style=\"width: 18mm; text-align: center; border: 1px solid black;\"><b>ราคา/หน่วย</b></th>\r\n        </tr>\r\n        \r\n        {% for ett in doc.eyewear_transaction_table %}\r\n\r\n            {% set bar = frappe.get_doc(\"Eyeglasses Information\", ett.barcode) %}\r\n        \r\n        <tr>\r\n            <td style=\"text-align: center; border: 1px solid black;\">{{ ett.idx }}</td>\r\n            <td style=\"text-align: left; border: 1px solid black;\">{{ ett.barcode }}</td>\r\n            <td style=\"text-align: left; border: 1px solid black;\">{{ ett.brand or '' }}</td>\r\n\r\n            {% if ett.type == \"เลนส์\"%}\r\n            <td style=\"text-align: left; border: 1px solid black;\">{{ bar.lens_types or '' }}</td>\r\n            {% else %}\r\n            <td style=\"text-align: left; border: 1px solid black;\">{{ ett.model or '' }}</td>\r\n            {% endif %}\r\n\r\n            <td style=\"text-align: center; border: 1px solid black;\">{{ ett.qty }}</td>\r\n\r\n            {% if ett.type == \"เลนส์\" and ett.model == \"000เลนส์สั่งตัด\" %}\r\n            <td style=\"text-align: center; border: 1px solid black;\">{{ '{:20,.2f}'.format(ett.actual_selling_price) }}</td> \r\n            {% else %}\r\n            <td style=\"text-align: center; border: 1px solid black;\">{{ '{:20,.2f}'.format(ett.selling_price) }}</td> \r\n            {% endif %}\r\n        </tr>\r\n\r\n        {% endfor %}\r\n           \r\n       </table>\r\n\r\n       <div>\r\n           <table style=\"width: 97%;margin-top: -6mm;text-align: right;\">\r\n               <tr>\r\n                   <td style=\"text-indent: 135mm\"><b>รวมเป็