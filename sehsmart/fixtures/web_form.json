  "client_script": "frappe.web_form.on('coupon_detail_juksu', (field, value) => {\r\n    if (value) {\r\n        frappe.call({\r\n            method: 'erpnext.link_coupon_data_web_form.get_coupon_detail',\r\n            args: {\r\n                name: value\r\n            },\r\n            callback: function(r) {\r\n                if (r.message) {\r\n                    let data = r.message;\r\n                    frappe.web_form.set_value('hn', data.hn);\r\n                    frappe.web_form.set_value('vn', data.vn);\r\n                    frappe.web_form.set_value('fullname', data.fullname);\r\n                    frappe.web_form.set_value('telephone_number', data.telephone_number);\r\n                    frappe.web_form.set_value('receipt_no', data.receipt_no);\r\n                    frappe.web_form.set_value('salutation', data.salutation);\r\n                    frappe.web_form.set_value('namef', data.namef);\r\n                    frappe.web_form.set_value('lastname', data.lastname);\r\n                    frappe.web_form.set_value('posting_date', data.posting_date);\r\n                    frappe.web_form.set_value('coupon_code', data.coupon_code);\r\n                    frappe.web_form.set_value('packet_name', data.packet_name);\r\n                }\r\n            }\r\n        });\r\n    }\r\n});\r\n\r\n\r\n\r\n\r\n\r\nfrappe.web_form.on('coupon_code', (field, value) => {\r\n    if (value) {\r\n        frappe.call({\r\n            method: 'erpnext.update_status_coupon.update_coupon_detail_state_by_code', // ✅ Python method\r\n            args: {\r\n                coupon_code: value // ✅ ส่งค่าที่กรอกไป\r\n            },\r\n            callback: function(r) {\r\n                // ✅ ไม่แสดงอะไรตามที่คุณต้องการ\r\n            }\r\n        });\r\n    }\r\n});\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n",
