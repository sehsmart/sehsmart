  "button_label": "Save",
  "client_script": "document.addEventListener('contextmenu', event => event.preventDefault()); \r\n\r\n//เรียกแบบฟอร์มปริ้น เพื่อให้สามารถปริ้นได้โดยไม่ต้อง Login\r\nfrappe.web_form.after_save = function() {\r\n    let doc = frappe.web_form.doc;\r\n    if (!doc) {\r\n        console.error('Document is undefined');\r\n        return;\r\n    }\r\n    let doctype = encodeURIComponent(doc.doctype);\r\n\r\n    // ดึงค่า an จาก doc.an\r\n    let coupon_code = doc.coupon_code;\r\n    if (!coupon_code) {\r\n        console.error('Field an is empty');\r\n        return;\r\n    }\r\n    let name = encodeURIComponent(coupon_code);\r\n\r\n    // ระบุชื่อ Print Format ที่ต้องการ\r\n    let print_format = encodeURIComponent(\"แบบฟอร์มปริ้นคูปอง\");\r\n\r\n    // สร้าง URL ที่ระบุ Print Format\r\n    let print_url = `/printview?doctype=${doctype}&name=${name}&format=${print_format}`;\r\n\r\n    window.open(print_url, '_blank');\r\n};\r\n\r\n// login Auto\r\nfrappe.web_form.after_save = () => {\r\n    const docname = frappe.web_form.doc.coupon_code;\r\n\r\n    frappe.call({\r\n        method: 'erpnext.coupon_juksu.get_auto_sid',\r\n        callback: function (r) {\r\n            if (r.message && r.message.sid) {\r\n                // Set sid เป็น cookie\r\n                document.cookie = `sid=${r.message.sid}; path=/`;\r\n\r\n                // ไปหน้า Desk app\r\n                window.location.href = `/app/coupon-juksu/${docname}`;\r\n            } else {\r\n                frappe.msgprint(\"Login ไม่สำเร็จ\");\r\n            }\r\n        }\r\n    });\r\n};\r\n\r\nfrappe.web_form.after_load = () => {\r\n    // ใช้วันที่วันนี้ โดยไม่ต้องให้ user เลือก\r\n    const today = frappe.datetime.get_today();\r\n\r\n    frappe.call({\r\n        method: \"erpnext.coupon_number.get_next_coupon_code\",\r\n        args: {\r\n            posting_date: today\r\n        },\r\n        callback: function(r) {\r\n            if (r.message && r.message.coupon_code) {\r\n                frappe.web_form.set_value(\"coupon_code\", r.message.coupon_code);\r\n            }\r\n        }\r\n    });\r\n};\r\n\r\nfrappe.web_form.on('salutation', update_fullname);\r\nfrappe.web_form.on('namef', update_fullname);\r\nfrappe.web_form.on('lastname', update_fullname);\r\n\r\nfunction update_fullname() {\r\n    let salutation = frappe.web_form.get_value('salutation') || '';\r\n    let namef = frappe.web_form.get_value('namef') || '';\r\n    let lastname = frappe.web_form.get_value('lastname') || '';\r\n\r\n    let fullname = `${salutation}${namef} ${lastname}`.trim(); // ตัดช่องว่างส่วนเกิน\r\n    frappe.web_form.set_value('fullname', fullname);\r\n}\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n",
